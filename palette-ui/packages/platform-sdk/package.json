{
  "name": "@palette/platform-sdk",
  "version": "0.3.0",
  "description": "Palette unified SDK — single entry point for all platform capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@palette/platform-api-client": "workspace:*",
    "@palette/platform-config": "workspace:*",
    "@palette/platform-event": "workspace:*",
    "@palette/platform-layout": "workspace:*",
    "@palette/platform-navigation": "workspace:*",
    "@palette/platform-provider": "workspace:*",
    "@palette/platform-security": "workspace:*",
    "@palette/platform-shell": "workspace:*",
    "@palette/ui-common": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
